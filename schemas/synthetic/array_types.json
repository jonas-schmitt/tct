{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Array Types Test",
  "description": "Test different array patterns to verify array tokenization",
  "type": "object",
  "properties": {
    "strings": {
      "type": "array",
      "items": {"type": "string"}
    },
    "numbers": {
      "type": "array",
      "items": {"type": "number"}
    }
  },
  "required": ["strings", "numbers"]
}