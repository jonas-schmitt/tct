  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Enum with Optional Fields Bug Reproduction",
  "type": "object",
  "properties": {
    "value": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "properties": {
            "field1": { "type": "string" },
            "field2": { "type": "string" },
            "field3": { "type": "string" }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "required": ["value"],
  "additionalProperties": false
}