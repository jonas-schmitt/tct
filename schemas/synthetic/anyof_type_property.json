{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Test anyOf with type property (Rust keyword)",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string"
    }
  },
  "anyOf": [
    {
      "type": "object",
      "required": ["name"]
    },
    {
      "type": "object",
      "required": ["type"]
    }
  ]
}
