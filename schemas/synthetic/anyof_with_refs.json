{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AnyOf with References Test",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "author": { "$ref": "#/definitions/Person" }
      },
      "required": ["name"],
      "not": { "required": ["legacy"] }
    },
    {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "author": { "$ref": "#/definitions/Person" },
        "legacy": { "type": "boolean" }
      },
      "required": ["name", "legacy"]
    }
  ],
  "definitions": {
    "Person": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "email": { "type": "string", "format": "email" }
          },
          "required": ["name"]
        }
      ]
    }
  }
}
