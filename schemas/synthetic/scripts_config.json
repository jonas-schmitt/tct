{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Scripts and Config Test",
  "description": "Tests package.json scripts and config patterns",
  "type": "object",
  "properties": {
    "scripts": {
      "type": "object",
      "additionalProperties": {"type": "string"},
      "properties": {
        "test": {"type": "string"},
        "build": {"type": "string"},
        "start": {"type": "string"},
        "preinstall": {"type": "string"},
        "postinstall": {"type": "string"}
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": true
    },
    "engines": {
      "type": "object",
      "properties": {
        "node": {"type": "string"},
        "npm": {"type": "string"}
      },
      "additionalProperties": {"type": "string"}
    },
    "os": {
      "type": "array",
      "items": {"type": "string"}
    },
    "cpu": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}