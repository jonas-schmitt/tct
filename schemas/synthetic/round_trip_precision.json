{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RoundTripPrecision",
  "description": "Minimal schema to isolate round-trip precision failures",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "count": {
      "type": "number"
    },
    "config": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "timeout": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": ["name"],
  "additionalProperties": false
}