{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UnionMixedTypes",
  "description": "Tests union with very different type variants: string, object, array, null",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "value": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "key": {"type": "string"}
          },
          "additionalProperties": true
        },
        {
          "type": "array",
          "items": {"type": "string"}
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": ["name"],
  "additionalProperties": false
}