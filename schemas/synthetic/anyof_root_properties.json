{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Test anyOf with root-level properties",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    }
  },
  "anyOf": [
    {
      "type": "object",
      "required": ["name"]
    },
    {
      "type": "object",
      "required": ["version"]
    }
  ]
}
