{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Tuple Array",
  "description": "Array with specific item schemas (tuple validation)",
  "type": "array",
  "items": [
    {
      "type": "number",
      "enum": [0, 1, 2]
    },
    {
      "type": "string",
      "enum": ["always", "never"]
    },
    {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  ],
  "minItems": 2,
  "maxItems": 3,
  "additionalItems": false
}