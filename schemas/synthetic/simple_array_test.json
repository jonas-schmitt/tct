{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Simple Array Test",
  "type": "object",
  "properties": {
    "items": {
      "$ref": "#/definitions/itemsList"
    }
  },
  "definitions": {
    "itemsList": {
      "type": "array",
      "description": "Array of complex items",
      "items": {
        "$ref": "#/definitions/itemData"
      }
    },
    "itemData": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "type": "number"
        }
      },
      "required": ["name", "value"]
    }
  }
}