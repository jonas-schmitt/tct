{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AnyOf with Additional Properties Test",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "name": { "type": "string" }
      },
      "required": ["name"],
      "not": { "required": ["version"] }
    },
    {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" }
      },
      "required": ["name", "version"]
    }
  ]
}
