{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ObjectVsNull",
  "description": "Tests object vs null union pattern found in github-workflow",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "config": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "setting": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": ["name", "config"],
  "additionalProperties": false
}