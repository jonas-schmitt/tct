{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NestedDefinitionRef",
  "description": "Test schema for nested $ref paths like #/definitions/foo/bar",
  "type": "object",
  "properties": {
    "notification": {
      "$ref": "#/definitions/notificationTypes/email"
    }
  },
  "definitions": {
    "notificationTypes": {
      "email": {
        "type": "object",
        "properties": {
          "address": { "type": "string" },
          "enabled": { "type": "boolean" }
        }
      },
      "sms": {
        "type": "object",
        "properties": {
          "phone": { "type": "string" },
          "enabled": { "type": "boolean" }
        }
      }
    }
  }
}
