{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Bounded Types Test",
  "description": "Types with constrained ranges that can be optimized",
  "type": "object",
  "properties": {
    "percentage": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "Bounded integer [0-100] - 1 token with bounded encoding"
    },
    "rating": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "Bounded integer [1-5] - 1 token with bounded encoding"
    },
    "short_string": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10,
      "description": "Bounded string - length in [1-10] range"
    },
    "fixed_array": {
      "type": "array",
      "items": {
        "type": "boolean"
      },
      "minItems": 3,
      "maxItems": 3,
      "description": "Fixed-size array - always 3 items"
    }
  },
  "required": ["percentage", "rating", "short_string", "fixed_array"]
}