{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Object with Tuple Array Values",
  "description": "Object with additionalProperties referencing a tuple array definition",
  "definitions": {
    "ruleValue": {
      "oneOf": [
        {
          "type": "array",
          "items": [
            {
              "type": "number",
              "enum": [0, 1, 2]
            },
            {
              "type": "string",
              "enum": ["always", "never"]
            },
            {
              "description": "Value: the value for this rule"
            }
          ],
          "minItems": 2,
          "maxItems": 3,
          "additionalItems": false
        }
      ]
    }
  },
  "type": "object",
  "properties": {
    "rules": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/ruleValue"
      }
    }
  }
}