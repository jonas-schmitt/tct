{
  "language": "node_js",
  "node_js": ["14", "16", "18"],
  "cache": "npm",
  "before_script": [
    "npm install"
  ],
  "script": [
    "npm test",
    "npm run lint"
  ],
  "after_success": [
    "npm run coverage"
  ],
  "deploy": {
    "provider": "pages",
    "skip_cleanup": true,
    "github_token": "$GITHUB_TOKEN",
    "local_dir": "build",
    "on": {
      "branch": "main"
    }
  },
  "env": {
    "global": [
      "NODE_ENV=test"
    ]
  },
  "os": "linux",
  "dist": "focal"
}