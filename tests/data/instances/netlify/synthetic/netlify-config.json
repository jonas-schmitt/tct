{
  "build": {
    "command": "npm run build",
    "publish": "dist/"
  },
  "redirects": [
    {
      "from": "/old-path",
      "to": "/new-path",
      "status": 301
    }
  ],
  "headers": [
    {
      "for": "/*",
      "values": {
        "X-Frame-Options": "DENY",
        "X-XSS-Protection": "1; mode=block"
      }
    }
  ],
  "functions": {
    "directory": "netlify/functions/"
  },
  "plugins": [
    {
      "package": "@netlify/plugin-sitemap"
    }
  ]
}