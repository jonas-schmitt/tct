{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "tct-public-demo",
    "namespace": "tct-fixtures"
  },
  "spec": {
    "replicas": 2,
    "revisionHistoryLimit": 3,
    "selector": {
      "matchLabels": {
        "app": "tct-public-demo"
      }
    },
    "template": {
      "metadata": {
        "labels": {
          "app": "tct-public-demo"
        }
      },
      "spec": {
        "containers": [
          {
            "name": "widget",
            "image": "registry.example.invalid/tct/widget:1",
            "args": ["serve", "--message=synthetic fixture"],
            "env": [
              {
                "name": "LOG_LEVEL",
                "value": "debug"
              }
            ],
            "ports": [
              {
                "name": "http",
                "containerPort": 8080
              }
            ],
            "resources": {
              "requests": {
                "cpu": "100m",
                "memory": "64Mi"
              }
            },
            "readinessProbe": {
              "httpGet": {
                "path": "/ready",
                "port": "http"
              },
              "initialDelaySeconds": 1,
              "periodSeconds": 5
            }
          }
        ],
        "terminationGracePeriodSeconds": 10
      }
    }
  }
}
