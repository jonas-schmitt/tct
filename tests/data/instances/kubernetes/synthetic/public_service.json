{
  "apiVersion": "v1",
  "kind": "Service",
  "metadata": {
    "name": "tct-public-demo",
    "namespace": "tct-fixtures",
    "labels": {
      "app": "tct-public-demo"
    }
  },
  "spec": {
    "type": "ClusterIP",
    "selector": {
      "app": "tct-public-demo"
    },
    "ports": [
      {
        "name": "http",
        "port": 80,
        "protocol": "TCP",
        "targetPort": "http"
      },
      {
        "name": "metrics",
        "port": 9090,
        "protocol": "TCP",
        "targetPort": 9090
      }
    ],
    "sessionAffinity": "None"
  }
}
