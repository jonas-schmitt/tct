{
  "service": {
    "name": "fixture-featured",
    "version": "0.0.0",
    "environment": "staging",
    "port": 8444,
    "health_check": {
      "path": "/health",
      "interval": 20,
      "timeout": 3,
      "retries": 2
    }
  },
  "database": {
    "type": "postgresql",
    "host": "database.example.invalid",
    "port": 5432,
    "name": "fixture-data",
    "ssl": true,
    "pool": {
      "min": 0,
      "max": 4,
      "idle_timeout": 30
    }
  },
  "logging": {
    "level": "info",
    "format": "json",
    "outputs": [
      {
        "type": "console",
        "config": {
          "pretty": false,
          "max_lines": 50
        }
      },
      {
        "type": "file",
        "config": {
          "path": "./scratch/fixture.log",
          "append": true
        }
      }
    ]
  },
  "features": {
    "preview_cache": {
      "enabled": true,
      "config": {
        "capacity": 8,
        "strategy": "fifo"
      },
      "rollout": {
        "percentage": 12.5,
        "audiences": [
          "internal",
          "testers"
        ]
      }
    },
    "legacy_mode": {
      "enabled": false
    }
  }
}
