{
  "variables": {
    "GO_VERSION": null,
    "DOCS_FORMATS": "md",
    "DESTDIR": "./bin",
    "TEST_COVERAGE": null,
    "GOLANGCI_LINT_MULTIPLATFORM": "",
    "HTTP_PROXY": "",
    "HTTPS_PROXY": "",
    "NO_PROXY": "",
    "TEST_BUILDKIT_TAG": null,
    "GOVULNCHECK_FORMAT": null
  },
  "targets": {
    "meta-helper": {
      "tags": ["docker/buildx-bin:local"]
    },
    "_common": {
      "args": {
        "GO_VERSION": "${GO_VERSION}",
        "BUILDKIT_CONTEXT_KEEP_GIT_DIR": 1
      }
    },
    "lint": {
      "inherits": ["_common"],
      "dockerfile": "./hack/dockerfiles/lint.Dockerfile",
      "output": ["type=cacheonly"],
      "platforms": ["darwin/amd64", "linux/amd64", "windows/amd64"]
    },
    "binaries": {
      "inherits": ["_common"],
      "target": "binaries",
      "dockerfile": "Dockerfile",
      "platforms": ["local"],
      "output": ["${DESTDIR}"]
    },
    "integration-tests": {
      "inherits": ["_common"],
      "target": "integration-test",
      "output": ["type=cacheonly"]
    }
  },
  "groups": {
    "default": {
      "targets": ["binaries"]
    },
    "validate": {
      "targets": ["lint", "lint-gopls", "validate-golangci", "validate-vendor", "validate-docs"]
    },
    "test": {
      "targets": ["test", "integration-tests"]
    }
  }
}