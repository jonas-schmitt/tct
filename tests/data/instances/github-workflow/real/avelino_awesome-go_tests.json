{
  "name": "tests",
  "on": {
    "push": {
      "branches": [
        "main"
      ]
    },
    "pull_request": null
  },
  "permissions": {
    "contents": "read"
  },
  "jobs": {
    "build": {
      "name": "Running test",
      "runs-on": "ubuntu-latest",
      "container": "golang:latest",
      "steps": [
        {
          "uses": "actions/checkout@v4"
        },
        {
          "name": "Get dependencies",
          "run": "go get -v -t -d ./..."
        },
        {
          "name": "Run tests",
          "run": "go test main_test.go main.go"
        }
      ]
    }
  }
}