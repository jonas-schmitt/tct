{
  "name": "Run benchmark comparison",
  "on": {
    "issue_comment": {
      "types": [
        "created"
      ]
    }
  },
  "permissions": "read-all",
  "jobs": {
    "benchmark-compare": {
      "runs-on": "ubuntu-latest",
      "if": "${{ github.event.issue.pull_request && startsWith(github.event.comment.body, '/benchmark-compare ')}}",
      "steps": [
        {
          "uses": "TheModdingInquisition/actions-team-membership@a69636a92bc927f32c3910baac06bacc949c984c",
          "with": {
            "team": "team",
            "organization": "angular",
            "token": "${{secrets.BENCHMARK_COMPARE_MEMBERSHIP_GITHUB_TOKEN}}",
            "exit": true
          }
        },
        {
          "uses": "peter-evans/create-or-update-comment@e8674b075228eee787fea43ef493e45ece1004c9",
          "with": {
            "comment-id": "${{github.event.comment.id}}",
            "token": "${{secrets.BENCHMARK_POST_RESULTS_GITHUB_TOKEN}}",
            "reactions": "rocket"
          }
        },
        {
          "uses": "alessbell/pull-request-comment-branch@aad01d65d6982b8eacabed5e9a684cd8ceb98da6",
          "id": "comment-branch"
        },
        {
          "uses": "actions/checkout@08c6903cd8c0fde910a37f88322edcfb5dd907a8",
          "with": {
            "repository": "${{steps.comment-branch.outputs.head_owner}}/${{steps.comment-branch.outputs.head_repo}}",
            "ref": "${{steps.comment-branch.outputs.head_ref}}"
          }
        },
        {
          "run": "pnpm install --frozen-lockfile"
        },
        {
          "uses": "angular/dev-infra/github-actions/bazel/configure-remote@b7672ff60456719e6d9b0cc052abc73a7adc8df2",
          "with": {
            "bazelrc": "./.bazelrc.user"
          }
        },
        {
          "name": "Preparing benchmark for GitHub action",
          "id": "info",
          "env": {
            "COMMENT_BODY": "${{ github.event.comment.body }}"
          },
          "run": "pnpm benchmarks prepare-for-github-action \"$COMMENT_BODY\""
        },
        {
          "run": "pnpm benchmarks run-compare ${{steps.info.outputs.compareSha}} ${{steps.info.outputs.benchmarkTarget}}",
          "id": "benchmark",
          "name": "Running benchmark"
        },
        {
          "uses": "peter-evans/create-or-update-comment@e8674b075228eee787fea43ef493e45ece1004c9",
          "with": {
            "issue-number": "${{github.event.issue.number}}",
            "token": "${{secrets.BENCHMARK_POST_RESULTS_GITHUB_TOKEN}}",
            "body": "## Benchmark Test Results\n**Test**: `${{steps.info.outputs.benchmarkTarget}}`\n\n### PR (${{steps.info.outputs.prHeadSha}})\n${{steps.benchmark.outputs.workingStageResultsText}}\n\n### Compare Ref (${{steps.info.outputs.compareSha}})\n${{steps.benchmark.outputs.comparisonResultsText}}\n"
          }
        }
      ]
    }
  }
}