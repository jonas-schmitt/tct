{
  "name": "Synthetic fixture matrix",
  "on": {
    "workflow_dispatch": {
      "inputs": {
        "greeting": {
          "description": "Synthetic greeting",
          "required": true,
          "default": "hello",
          "type": "string"
        }
      }
    }
  },
  "jobs": {
    "repeat": {
      "runs-on": "ubuntu-latest",
      "strategy": {
        "fail-fast": false,
        "matrix": {"variant": ["alpha", "beta"]}
      },
      "steps": [
        {
          "env": {"FIXTURE_VARIANT": "${{ matrix.variant }}"},
          "run": "printf '%s\\n' \"$FIXTURE_VARIANT\""
        },
        {
          "env": {"FIXTURE_GREETING": "${{ inputs.greeting }}"},
          "run": "printf '%s\\n' \"$FIXTURE_GREETING\""
        }
      ]
    }
  }
}
