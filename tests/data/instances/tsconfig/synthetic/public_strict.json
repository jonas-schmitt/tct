{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "skipLibCheck": false,
    "baseUrl": ".",
    "paths": {
      "@fixture/*": ["./src/*"]
    },
    "types": []
  },
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "exclude": ["output", "scratch"]
}
