{
  "extends": [
    "tslint:recommended"
  ],
  "rules": {
    "no-console": false,
    "object-literal-sort-keys": false,
    "member-ordering": [
      true,
      {
        "order": [
          "static-field",
          "instance-field",
          "static-method",
          "instance-method"
        ]
      }
    ],
    "quotemark": [true, "single"],
    "semicolon": [true, "always"],
    "trailing-comma": [
      true,
      {
        "multiline": "always",
        "singleline": "never"
      }
    ]
  },
  "linterOptions": {
    "exclude": [
      "node_modules/**"
    ]
  }
}