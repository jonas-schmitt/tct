{
  "tool": {
    "poetry": {
      "name": "my-python-app",
      "version": "1.0.0",
      "description": "A sample Python application",
      "authors": ["John Doe <john@example.com>"],
      "license": "MIT",
      "readme": "README.md",
      "homepage": "https://github.com/example/my-python-app",
      "repository": "https://github.com/example/my-python-app",
      "keywords": ["python", "web", "api"],
      "classifiers": [
        "Development Status :: 4 - Beta",
        "Programming Language :: Python :: 3.8",
        "Programming Language :: Python :: 3.9"
      ],
      "dependencies": {
        "python": "^3.8",
        "fastapi": "^0.68.0",
        "uvicorn": "^0.15.0",
        "pydantic": "^1.8.0"
      },
      "group": {
        "dev": {
          "dependencies": {
            "pytest": "^6.2.0",
            "black": "^21.7b0",
            "flake8": "^3.9.0"
          }
        }
      },
      "scripts": {
        "start": "uvicorn app.main:app --reload",
        "test": "pytest"
      }
    }
  },
  "build-system": {
    "requires": ["poetry-core>=1.0.0"],
    "build-backend": "poetry.core.masonry.api"
  }
}