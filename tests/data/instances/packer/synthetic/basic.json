{
  "builders": [
    {
      "type": "amazon-ebs",
      "access_key": "{{user `aws_access_key`}}",
      "secret_key": "{{user `aws_secret_key`}}",
      "region": "us-east-1",
      "source_ami": "ami-12345678",
      "instance_type": "t2.micro",
      "ssh_username": "ubuntu",
      "ami_name": "my-app-{{timestamp}}"
    }
  ],
  "provisioners": [
    {
      "type": "shell",
      "inline": [
        "sudo apt-get update",
        "sudo apt-get install -y nginx"
      ]
    },
    {
      "type": "file",
      "source": "./app.tar.gz",
      "destination": "/tmp/app.tar.gz"
    }
  ],
  "variables": {
    "aws_access_key": "",
    "aws_secret_key": ""
  }
}